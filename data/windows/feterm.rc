/* Windows resources: icon, manifest and version information (built by the Makefile with windres). */
#include <winver.h>
#include "app_name.h"

#define RT_MANIFEST_ID 24

1 ICON "feterm.ico"
1 RT_MANIFEST_ID "feterm.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_NUM
PRODUCTVERSION  APP_VERSION_NUM
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      APP_AUTHOR
            VALUE "FileDescription",  APP_DISPLAY_NAME " terminal"
            VALUE "FileVersion",      APP_VERSION
            VALUE "InternalName",     APP_NAME
            VALUE "LegalCopyright",   "\251 " APP_AUTHOR
            VALUE "OriginalFilename", APP_NAME ".exe"
            VALUE "ProductName",      APP_DISPLAY_NAME
            VALUE "ProductVersion",   APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
