[Desktop Entry]
Type=Application
Name=@DISPLAY_NAME@
GenericName=Terminal
Comment=Terminal emulator with syntax highlighting for Cisco, Arista and Juniper
TryExec=@NAME@
Exec=@NAME@
Icon=@APP_ID@
Terminal=false
StartupNotify=true
StartupWMClass=@APP_ID@
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;cmd;terminal;ssh;cisco;arista;juniper;network;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@NAME@
