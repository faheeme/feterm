# Maintainer: Faheem Essack <faheem.essack@gmail.com>
#
# Built and signed by packaging/alpine/build-repo.sh for the FeTerm apk
# repository (https://faheeme.gitlab.io/feterm-apk/), not for aports.
pkgname=feterm
pkgver=0.5.3
pkgrel=0
pkgdesc="Modern terminal emulator with PCRE2 syntax highlighting for Cisco, Arista and Juniper"
url="https://faheeme.gitlab.io/feterm-site/"
arch="x86_64 aarch64"
license="MIT"
# SDL3 loads its video backends, EGL and the GL drivers at run time, so they
# are listed here; the libraries FeTerm links directly come from so: autodeps.
depends="
	font-jetbrains-mono
	libdecor
	libx11
	libxcursor
	libxext
	libxfixes
	libxi
	libxkbcommon
	libxrandr
	mesa-dri-gallium
	mesa-egl
	wayland-libs-client
	wayland-libs-cursor
	wayland-libs-egl
	"
makedepends="
	fontconfig-dev
	freetype-dev
	linux-headers
	mesa-dev
	pcre2-dev
	sdl3-dev
	"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://gitlab.com/faheeme/feterm/-/archive/v$pkgver/feterm-v$pkgver.tar.gz"
builddir="$srcdir/feterm-v$pkgver"

build() {
	make PREFIX=/usr WERROR=
}

check() {
	make WERROR= test
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
18d8689b88cef21d7e998f0d925d336a77b9021bb7d5cc62169c3d371695028ec5cc00c609f1fa8c6a3b4abbe6015f05c1aa14d8bd841779d5e430d09a1f5f5f  feterm-0.5.3.tar.gz
"
